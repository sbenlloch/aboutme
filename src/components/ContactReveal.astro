---
import { profile } from "@data/profile";

interface Props {
  label: string;
  variant?: "primary" | "plain";
}

const { label, variant = "plain" } = Astro.props;
---

<button
  class:list={["button", { primary: variant === "primary" }]}
  type="button"
  data-contact-reveal
  data-contact={profile.emailEncoded}
>
  {label}
</button>

<script>
  document.querySelectorAll<HTMLButtonElement>("[data-contact-reveal]").forEach((button) => {
    button.addEventListener("click", () => {
      const address = atob(button.dataset.contact ?? "").split("").reverse().join("");
      if (address) window.location.href = `mailto:${address}`;
    });
  });
</script>
